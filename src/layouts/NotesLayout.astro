---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NoteTree from '../components/NoteTree.astro';
import { buildNoteTree } from '../data/notes';

interface Props {
	entry: CollectionEntry<'notes'>;
	seriesNotes?: CollectionEntry<'notes'>[];
	prevNote?: CollectionEntry<'notes'>;
	nextNote?: CollectionEntry<'notes'>;
}

const { entry, seriesNotes = [], prevNote, nextNote } = Astro.props;
const { title, description, pubDate, section, chapter, series, tags = [], readingTime } = entry.data;

// 获取系列信息
const seriesTitle = series || section || 'Notes';
const seriesCount = seriesNotes.length;
const noteTree = buildNoteTree(seriesNotes, entry.id);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<link rel="stylesheet" href="/src/styles/global.css" />
	</head>
	<body>
		<Header />

		<article class="notes-article">
			<!-- 顶部色条 -->
			<div class="top-bar"></div>

			<!-- 面包屑导航 -->
			<div class="breadcrumb">
				<a href="/notes">← Notes</a>
				{series && (
					<>
						<span class="separator">/</span>
						<span class="current-series">{series}</span>
					</>
				)}
			</div>

			<div class="article-layout">
				<aside id="notes-sidebar" class="sidebar">
					<div class="sidebar-topbar">
						<button
							id="notes-sidebar-toggle"
							class="sidebar-toggle"
							type="button"
							aria-label="Hide sidebar"
							title="Hide sidebar"
							aria-expanded="true"
							aria-controls="notes-sidebar"
						>
							<span aria-hidden="true">‹</span>
						</button>
					</div>

					<div class="series-label">系列 · Series</div>
					<div class="series-title">{seriesTitle}</div>
					{seriesCount > 0 && <div class="series-meta">{seriesCount} 篇 · 持续更新</div>}

					{noteTree.length > 0 && (
						<nav class="series-nav" aria-label={`${seriesTitle} notes`}>
							<NoteTree nodes={noteTree} />
						</nav>
					)}
				</aside>

				<!-- 正文 -->
				<div class="content">
					<div class="content-toolbar">
						<button
							id="notes-sidebar-toggle-inline"
							class="sidebar-toggle inline-toggle"
							type="button"
							aria-label="Show sidebar"
							title="Show sidebar"
							aria-expanded="false"
							aria-controls="notes-sidebar"
							hidden
						>
							<span aria-hidden="true">☰</span>
						</button>
					</div>

					<!-- 元信息 -->
					<div class="meta-info">
						{section && <span class="category">{section}</span>}
						{section && <span class="dot"></span>}
						<span><FormattedDate date={pubDate} format="YYYY-MM-DD" /></span>
						{readingTime && (
							<>
								<span class="dot"></span>
								<span>{readingTime}</span>
							</>
						)}
					</div>

					<!-- 标题 -->
					<h1>{title}</h1>

					<!-- 描述 -->
					{description && <p class="description">{description}</p>}

					<!-- 文章内容 -->
					<div class="prose">
						<slot />
					</div>

					<!-- 标签 -->
					{tags.length > 0 && (
						<div class="tags-section">
							<span class="tags-label">标签</span>
							{tags.map((tag) => (
								<span class="tag">#{tag}</span>
							))}
						</div>
					)}

					<!-- 上一篇/下一篇 -->
					{(prevNote || nextNote) && (
						<nav class="pagination">
							{prevNote ? (
								<a href={`/notes/${prevNote.id}/`} class="page-link prev">
									<div class="page-label">← 上一篇</div>
									<div class="page-title">{prevNote.data.title}</div>
								</a>
							) : (
								<div></div>
							)}
							{nextNote && (
								<a href={`/notes/${nextNote.id}/`} class="page-link next">
									<div class="page-label">下一篇 →</div>
									<div class="page-title">{nextNote.data.title}</div>
								</a>
							)}
						</nav>
					)}
				</div>
			</div>
		</article>

		<Footer />
		<script is:inline>
			const root = document.documentElement;
			const sidebar = document.getElementById('notes-sidebar');
			const button = document.getElementById('notes-sidebar-toggle');
			const inlineButton = document.getElementById('notes-sidebar-toggle-inline');
			const storageKey = 'notes-sidebar-collapsed';

			const applyCollapsed = (collapsed) => {
				root.classList.toggle('notes-sidebar-collapsed', collapsed);
				if (sidebar) sidebar.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
				if (button) {
					button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
				}
				if (inlineButton) {
					inlineButton.hidden = !collapsed;
					inlineButton.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
				}
			};

			applyCollapsed(localStorage.getItem(storageKey) === 'true');

			button?.addEventListener('click', () => {
				const next = !root.classList.contains('notes-sidebar-collapsed');
				localStorage.setItem(storageKey, String(next));
				applyCollapsed(next);
			});

			inlineButton?.addEventListener('click', () => {
				localStorage.setItem(storageKey, 'false');
				applyCollapsed(false);
			});

			// 展开/收起全部交给 CSS（.tree-panel 的 grid-template-rows 动画），
			// 这里只负责翻转状态，不需要测量高度，所以嵌套多少层都不会算错。
			for (const group of document.querySelectorAll('[data-note-group]')) {
				const toggle = group.querySelector('[data-note-toggle]');
				const panel = group.querySelector('[data-note-panel]');
				if (!(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) continue;

				toggle.addEventListener('click', () => {
					const expanded = toggle.getAttribute('aria-expanded') === 'true';
					toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
					panel.classList.toggle('open', !expanded);
				});
			}
		</script>
	</body>
</html>

<style>
	:global(html.notes-sidebar-collapsed) .sidebar {
		display: none;
	}

	.notes-article {
		background: var(--bg-white);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		/* 减去左右留白，卡片变宽后在中间宽度区间不会顶到屏幕边缘 */
		max-width: min(var(--max-width-notes), calc(100% - 3rem));
		margin: 3rem auto;
		color: var(--text-primary);
	}

	.top-bar {
		height: 4px;
		background: var(--notes-primary);
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 40px;
		border-bottom: 1px solid var(--border-weak);
		font-size: var(--text-md);
	}

	.breadcrumb a {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		color: var(--text-tertiary);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.breadcrumb a:hover {
		color: var(--notes-primary);
	}

	.separator {
		color: var(--border-light);
		margin: 0 8px;
	}

	.current-series {
		color: var(--notes-primary);
	}

	.article-layout {
		display: flex;
		align-items: stretch;
	}

	/* 侧栏 */
	.sidebar {
		width: var(--sidebar-width);
		flex-shrink: 0;
		border-right: 1px solid var(--border-weak);
		background: var(--bg-sidebar);
		padding: 22px 18px 30px;
	}

	.sidebar-topbar {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 14px;
	}

	.sidebar-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border: 1px solid var(--border-button);
		border-radius: var(--radius-pill);
		background: var(--bg-button);
		color: var(--text-tertiary);
		font-size: var(--text-xl);
		line-height: 1;
		transition:
			border-color 0.18s ease,
			background 0.18s ease,
			color 0.18s ease;
	}

	.sidebar-toggle:hover {
		border-color: var(--notes-primary);
		background: var(--notes-bg-lighter);
		color: var(--notes-primary-dark);
	}

	.inline-toggle {
		margin-bottom: 16px;
	}

	.inline-toggle[hidden] {
		display: none;
	}

	.series-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-meta-light);
		margin-bottom: 8px;
	}

	.series-title {
		font-weight: 700;
		font-size: var(--text-xl);
		color: var(--text-heading);
		margin-bottom: 4px;
	}

	.series-meta {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--post-meta);
		margin-bottom: 20px;
	}

	.series-nav {
		margin-top: 4px;
	}

	/* 正文 */
	.content {
		flex: 1;
		min-width: 0;
		padding: 40px 52px 48px;
	}

	.meta-info {
		display: flex;
		align-items: center;
		gap: 14px;
		font-family: var(--font-mono);
		font-size: var(--text-sm-plus);
		color: var(--post-meta);
		margin-bottom: 22px;
	}

	.category {
		color: var(--notes-primary);
		font-weight: 600;
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--border-light);
	}

	h1 {
		margin: 0 0 14px;
		font-weight: 800;
		font-size: var(--text-hero-xs);
		letter-spacing: -0.02em;
		line-height: var(--leading-snug);
		color: var(--text-heading-dark);
	}

	.description {
		margin: 0 0 36px;
		font-size: var(--text-prose);
		line-height: var(--leading-looser);
		color: var(--text-secondary);
		font-weight: 300;
	}

	/* Prose 样式 —— 技术笔记按信息密度调，比 essays 紧 */
	.prose {
		/* 侧栏堆叠后正文会撑满整张卡片，这里兜住行长，保持和两栏时一致的阅读宽度 */
		max-width: 860px;
		font-size: var(--text-prose);
		line-height: var(--leading-looser);
		color: var(--text-body);
	}

	/* 标题的 margin-top 是章节之间唯一的呼吸，不能是 0 */
	.prose :global(h2) {
		margin: 40px 0 14px;
		font-weight: 700;
		font-size: var(--text-4xl);
		letter-spacing: -0.01em;
		color: var(--text-heading);
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(h3) {
		margin: 28px 0 10px;
		font-weight: 600;
		font-size: var(--text-2xl);
		color: var(--text-heading);
	}

	.prose :global(p) {
		margin: 0 0 18px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 20px;
		padding-left: 22px;
		line-height: 1.72;
	}

	.prose :global(li) {
		margin-bottom: 6px;
	}

	/* Callout 提示框 */
	.prose :global(.callout) {
		display: flex;
		gap: 14px;
		padding: 16px 20px;
		background: var(--notes-bg-lighter);
		border: 1px solid var(--notes-border);
		border-left: 3px solid var(--notes-primary);
		border-radius: var(--radius-md);
		margin-bottom: 28px;
	}

	.prose :global(.callout p) {
		margin: 0;
		font-size: var(--text-lg);
		line-height: var(--leading-looser);
		color: #2c4a60;
	}

	/* 标签 */
	.tags-section {
		display: flex;
		align-items: center;
		gap: 9px;
		flex-wrap: wrap;
		padding-top: 26px;
		border-top: 1px solid var(--border-weak);
	}

	.tags-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-meta-light);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-right: 4px;
	}

	.tag {
		font-size: var(--text-base);
		color: var(--nav-text);
		background: var(--bg-tag);
		border-radius: var(--radius-full);
		padding: 5px 13px;
	}

	/* 翻页 */
	.pagination {
		display: flex;
		gap: 14px;
		margin-top: 30px;
	}

	.page-link {
		flex: 1;
		text-decoration: none;
		border: 1px solid #e4ebf0;
		border-radius: var(--radius-xl);
		padding: 14px 18px;
		transition: border-color 0.2s ease;
	}

	.page-link:hover {
		border-color: var(--notes-primary);
	}

	.page-link.next {
		text-align: right;
	}

	.page-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-meta-light);
		margin-bottom: 5px;
	}

	.page-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--nav-text);
	}

	@media (max-width: 1100px) {
		.notes-article {
			margin: 2rem 1rem;
		}

		.article-layout {
			flex-direction: column;
		}

		.sidebar {
			width: 100%;
			border-right: none;
			border-bottom: 1px solid var(--border-weak);
		}

		:global(html.notes-sidebar-collapsed) .sidebar {
			display: none;
		}
	}

	@media (max-width: 768px) {
		.breadcrumb,
		.content {
			padding: 20px 24px;
		}

		h1 {
			font-size: 28px;
		}

		.pagination {
			flex-direction: column;
		}
	}
</style>
