---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const essays = (await getCollection('essays')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Essays - ${SITE_TITLE}`} description="生活随笔 · 用文字记录的思考与感受" />
		<link rel="stylesheet" href="/src/styles/global.css" />
	</head>
	<body>
		<Header />
		<main class="essays-index">
			<header class="page-header">
				<h1>Essays</h1>
				<p class="page-intro">生活随笔 · 用文字记录的思考与感受</p>
			</header>

			<div class="essays-list">
				{essays.map((essay) => (
					<article class="essay-card">
						<a href={`/essays/${essay.id}/`}>
							<time><FormattedDate date={essay.data.pubDate} /></time>
							<h2>{essay.data.title}</h2>
							<p class="description">{essay.data.description}</p>
						</a>
					</article>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.essays-index {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	.page-header {
		padding: 0 0 36px;
	}

	.page-header h1 {
		margin: 0 0 10px;
		font-weight: 800;
		font-size: var(--text-hero-sm);
		letter-spacing: -0.02em;
		color: var(--essays-primary);
	}

	.page-intro {
		font-size: var(--text-2xl);
		color: var(--text-secondary);
		font-weight: 300;
	}

	.essays-list {
		display: grid;
		gap: 2rem;
	}

	.essay-card {
		border: 1px solid var(--border-weak);
		border-radius: var(--radius-xl);
		padding: 2rem;
		transition: all 0.2s ease;
	}

	.essay-card:hover {
		border-color: var(--essays-primary);
		box-shadow: 0 4px 12px rgba(176, 105, 78, 0.1);
	}

	.essay-card a {
		text-decoration: none;
		color: inherit;
	}

	.essay-card time {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text-meta);
		display: block;
		margin-bottom: 0.75rem;
	}

	.essay-card h2 {
		font-size: 1.5rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		color: var(--essays-heading);
		font-family: var(--font-wenkai);
	}

	.essay-card .description {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-body);
		margin: 0;
	}

	@media (max-width: 768px) {
		.essays-index {
			padding: 2rem 1.5rem;
		}

		.page-header h1 {
			font-size: 2rem;
		}
	}
</style>
