---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const latestPosts = (await getCollection('notes'))
	.concat(await getCollection('essays'))
	.concat(await getCollection('thoughts'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

// 获取分类标签
function getCategory(collection: string) {
	if (collection === 'notes') return { label: 'NLP', color: 'var(--notes-primary)' };
	if (collection === 'essays') return { label: '随笔', color: 'var(--link-secondary)' };
	if (collection === 'thoughts') return { label: 'Thoughts', color: 'var(--thoughts-primary)' };
	return { label: collection, color: 'var(--text-meta)' };
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="stylesheet" href="/src/styles/global.css" />
	</head>
	<body class="home-page">
		<Header />

		<!-- HERO -->
		<section class="hero">
			<div class="avatar">YH</div>
			<h1>
				<span class="name-en">YangHao</span>
			</h1>
			<div class="meta-info">
				<span class="location">
					<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--notes-primary)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					China / Beijing
				</span>
				<a href="https://github.com/cqnk2222" class="github-link">
					<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.39.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.16.57.67.48A10 10 0 0 0 12 2Z"></path>
					</svg>
					GitHub
				</a>
			</div>
		</section>

		<!-- MAIN CONTENT -->
		<main class="main-content">
			<!-- ABOUT -->
			<section class="section">
				<h2 class="section-title">About</h2>
				<div class="section-content">
					<div class="about-role">Student / Developer</div>
					<p class="about-text">Hello, I'm YangHao, a computer science student at Peking University. I'm interested in large language models, literature, and building a thoughtful space for notes and writing.</p>
					<div class="button-group">
						<a href="/about" class="button-outline">More about me →</a>
					</div>
				</div>
			</section>

			<!-- POSTS -->
			<section class="section">
				<h2 class="section-title">Posts</h2>
				<div class="section-content">
					<div class="posts-list">
						{latestPosts.map((post) => {
							const category = getCategory(post.collection);
							return (
								<a href={`/${post.collection}/${post.id}/`} class="post-item">
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} format="MMM DD" />
									</span>
									<span class="post-title">{post.data.title}</span>
									<span class="post-category" style={`color: ${category.color}`}>
										{category.label}
									</span>
								</a>
							);
						})}
					</div>
					<a href="/blog" class="more-link">More posts →</a>
				</div>
			</section>

			<!-- EDUCATION -->
			<section class="section">
				<h2 class="section-title">Education</h2>
				<div class="section-content">
					<div class="edu-list">
						<div class="edu-item">
							<span class="edu-period">2023 — Present</span>
							<div class="edu-details">
								<div class="edu-school">北京大学 Peking University</div>
								<div class="edu-major">信息与计算科学 · Information & Computing Science</div>
							</div>
						</div>
						<div class="edu-item">
							<span class="edu-period">2017 — 2023</span>
							<div class="edu-details">
								<div class="edu-school">重庆南开中学</div>
								<div class="edu-major">高中 · Senior High School</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ELSEWHERE -->
			<section class="section">
				<h2 class="section-title">Elsewhere</h2>
				<div class="section-content">
					<div class="links-grid">
						<a href="https://github.com/cqnk2222" class="link-card">
							<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.39.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.16.57.67.48A10 10 0 0 0 12 2Z"></path>
							</svg>
							GitHub
						</a>
						<a href="mailto:your@email.com" class="link-card">
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="5" width="18" height="14" rx="2"></rect>
								<path d="m3 7 9 6 9-6"></path>
							</svg>
							Email
						</a>
						<a href="/rss.xml" class="link-card">
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
								<circle cx="5" cy="19" r="1.4" fill="currentColor"></circle>
							</svg>
							RSS
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	/* Hero Section */
	.hero {
		text-align: center;
		padding: 46px 24px 8px;
	}

	.avatar {
		width: 128px;
		height: 128px;
		border-radius: 50%;
		margin: 0 auto 34px;
		background: var(--avatar-gradient);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--bg-white);
		font-weight: 700;
		font-size: var(--text-hero-xl);
		letter-spacing: -0.01em;
		box-shadow: var(--shadow-avatar);
		border: 5px solid var(--bg-white);
	}

	.hero h1 {
		margin: 0;
		font-size: var(--text-hero-2xl);
		letter-spacing: -0.02em;
		color: var(--text-heading-dark);
		line-height: var(--leading-tight);
	}

	.name-zh {
		font-family: var(--font-wenkai);
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.name-en {
		font-family: var(--font-inter);
		font-weight: 800;
	}

	.meta-info {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 38px;
		margin-top: 26px;
		font-size: var(--text-2xl);
		font-weight: 500;
		color: var(--text-secondary);
	}

	.location,
	.github-link {
		display: inline-flex;
		align-items: center;
		gap: 9px;
	}

	.github-link {
		transition: color 0.2s ease;
	}

	.github-link:hover {
		color: var(--nav-hover);
	}

	/* Main Content */
	.main-content {
		max-width: var(--max-width-content);
		margin: 0 auto;
		padding: 64px 40px 90px;
	}

	.section {
		display: grid;
		grid-template-columns: var(--grid-label-width) 1fr;
		gap: var(--grid-gap-main);
		padding: 42px 0;
		border-top: 1px solid var(--border-strong);
	}

	.section-title {
		margin: 0;
		font-weight: 800;
		font-size: var(--text-8xl);
		letter-spacing: -0.02em;
		color: var(--text-heading-dark);
	}

	.section-content {
		min-width: 0;
	}

	/* About Section */
	.about-role {
		font-size: var(--text-2xl);
		font-weight: 500;
		color: var(--about-subtitle);
		margin-bottom: 22px;
	}

	.about-text {
		margin: 0 0 28px;
		font-size: var(--text-2xl);
		line-height: var(--leading-body);
		color: var(--text-body);
		font-weight: 300;
	}

	.button-group {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
	}

	.button-outline {
		font-size: var(--text-lg);
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		border: 1px solid var(--border-button);
		border-radius: var(--radius-lg);
		padding: 8px 16px;
		background: var(--bg-button);
		white-space: nowrap;
		transition: all 0.2s ease;
	}

	.button-outline:hover {
		border-color: var(--nav-hover);
		color: var(--nav-hover);
	}

	/* Posts Section */
	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.post-item {
		display: flex;
		align-items: baseline;
		gap: 18px;
		padding: 14px 0;
		text-decoration: none;
		border-bottom: 1px solid var(--border-weak-alt);
		transition: background 0.2s ease;
	}

	.post-item:hover {
		background: var(--bg-hover);
	}

	.post-date {
		font-family: var(--font-mono);
		font-size: var(--text-base);
		color: var(--post-meta);
		flex-shrink: 0;
		width: 74px;
	}

	.post-title {
		flex: 1;
		font-size: var(--text-2xl);
		font-weight: 500;
		color: var(--text-heading);
		letter-spacing: -0.01em;
	}

	.post-category {
		font-size: var(--text-base);
		font-weight: 500;
		flex-shrink: 0;
	}

	.more-link {
		display: inline-block;
		margin-top: 20px;
		font-size: var(--text-lg);
		font-weight: 500;
		color: var(--notes-primary);
		text-decoration: none;
		transition: text-decoration 0.2s ease;
	}

	.more-link:hover {
		text-decoration: underline;
	}

	/* Education Section */
	.edu-list {
		display: flex;
		flex-direction: column;
	}

	.edu-item {
		display: flex;
		align-items: baseline;
		gap: 18px;
		padding: 6px 0 18px;
	}

	.edu-item + .edu-item {
		padding-top: 18px;
		border-top: 1px solid var(--border-weak);
	}

	.edu-period {
		font-family: var(--font-mono);
		font-size: var(--text-base);
		color: var(--post-meta);
		flex-shrink: 0;
		width: 150px;
	}

	.edu-details {
		flex: 1;
	}

	.edu-school {
		font-size: var(--text-2xl);
		font-weight: 600;
		color: var(--text-heading);
	}

	.edu-major {
		font-size: var(--text-lg);
		color: var(--text-tertiary);
		margin-top: 3px;
	}

	/* Links Section */
	.links-grid {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.link-card {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-size: var(--text-lg);
		font-weight: 500;
		color: var(--nav-text);
		text-decoration: none;
		border: 1px solid var(--border-button-alt);
		border-radius: var(--radius-xl);
		padding: 10px 16px;
		background: var(--bg-button-alt);
		transition: all 0.2s ease;
	}

	.link-card:hover {
		border-color: var(--nav-hover);
		color: var(--nav-hover);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero {
			padding: 32px 20px 8px;
		}

		.avatar {
			width: 96px;
			height: 96px;
			font-size: 32px;
			margin-bottom: 24px;
		}

		.hero h1 {
			font-size: 42px;
		}

		.meta-info {
			flex-direction: column;
			gap: 16px;
			font-size: 16px;
		}

		.main-content {
			padding: 40px 24px 60px;
		}

		.section {
			grid-template-columns: 1fr;
			gap: 24px;
			padding: 32px 0;
		}

		.edu-item {
			flex-direction: column;
			gap: 8px;
		}

		.edu-period {
			width: 100%;
		}
	}
</style>
