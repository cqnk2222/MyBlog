---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectBackdrop from '../../components/ProjectBackdrop.astro';
import { profile, projects } from '../../data/site';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects - ${SITE_TITLE}`} description="Projects, experiments, and repositories from Krinein Hao." />
	</head>
	<body class="projects-body">
		<ProjectBackdrop />
		<div class="projects-header"><Header /></div>
		<main class="projects-page" aria-labelledby="projects-title">
			<section class="intro" aria-labelledby="projects-title">
				<h1 id="projects-title">Projects</h1>
				<p>Things I’m building, exploring, and maintaining.</p>
				<a class="profile-link" href={profile.github} target="_blank" rel="noreferrer">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.9c0-1.1-.4-1.8-.8-2.2 2.8-.3 5.8-1.4 5.8-6.2 0-1.4-.5-2.5-1.3-3.4.1-.3.6-1.6-.1-3.3 0 0-1.1-.3-3.6 1.3a12.4 12.4 0 0 0-6 0C6.5 2.7 5.4 3 5.4 3c-.7 1.7-.2 3-.1 3.3C4.5 7.2 4 8.3 4 9.7c0 4.8 3 5.9 5.8 6.2-.4.4-.8 1.1-.8 2.2V22" />
					</svg>
					GitHub
					<span aria-hidden="true">↗</span>
				</a>
			</section>
			<div class="dot-divider" aria-hidden="true"><span></span><span></span><span></span></div>
			<section class="project-index" aria-labelledby="project-index-title">
				<h2 class="index-title" id="project-index-title">Selected projects</h2>
				<ul class="project-list" role="list">
					{projects.map((project) => (
						<li class="project-entry">
							<a class="project-link" href={project.github} target="_blank" rel="noreferrer">
								<svg class="project-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18" />
								</svg>
								<div class="project-copy">
									<h3>{project.title}<span class="project-arrow" aria-hidden="true">↗</span></h3>
									<p class="project-summary">{project.summary}</p>
								</div>
							</a>
							<div class="project-meta">
								<span class="project-status">{project.status}</span>
								<span class="project-stack">{project.stack.join(' · ')}</span>
								{project.demo && (
									<a class="demo-link" href={project.demo} target="_blank" rel="noreferrer" aria-label={`Open ${project.title} live site`}>
										Live site <span aria-hidden="true">↗</span>
									</a>
								)}
							</div>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-body {
		isolation: isolate;
		min-height: 100svh;
		font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	.projects-header :global(header) {
		max-width: none;
		padding-inline: clamp(24px, 4vw, 64px);
	}

	.projects-page {
		--project-ink: #30343b;
		--project-muted: #737983;
		--project-accent: #47796b;
		width: calc(100% - clamp(48px, 10vw, 160px));
		min-height: calc(100svh - 200px);
		margin: 0 auto;
		padding: 48px 0 96px;
	}

	.intro {
		text-align: center;
	}

	.intro h1 {
		color: var(--project-ink);
		font-size: 36px;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.12;
	}

	.intro > p {
		margin-top: 14px;
		color: var(--project-muted);
		font-size: 18px;
		font-style: italic;
		font-weight: 400;
		line-height: 1.7;
	}

	.profile-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 32px;
		color: var(--project-muted);
		font-size: 16px;
	}

	.profile-link > span {
		font-size: 12px;
	}

	.dot-divider {
		display: flex;
		justify-content: center;
		gap: 12px;
		margin: 48px 0 38px;
	}

	.dot-divider span {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #b8c4bf;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		list-style: none;
	}

	.index-title {
		margin: 0 0 24px;
		color: transparent;
		-webkit-text-stroke: 1px #c9cdd0;
		font-size: clamp(40px, 6.3vw, 100px);
		font-weight: 700;
		letter-spacing: -0.055em;
		line-height: 1.1;
	}

	.project-entry {
		padding: 16px 14px;
		border-radius: 6px;
		transition: background-color 180ms ease;
	}

	.project-entry:hover,
	.project-entry:focus-within {
		background: #8888880e;
	}

	.project-link {
		display: grid;
		grid-template-columns: 36px minmax(0, 1fr);
		gap: 18px;
	}

	.project-icon {
		width: 32px;
		height: 32px;
		margin-top: 5px;
		color: #969ba2;
		transition: color 180ms ease;
	}

	.project-copy {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.project-copy h3 {
		color: var(--project-ink);
		font-size: 18px;
		font-weight: 400;
		letter-spacing: -0.01em;
		line-height: 1.5;
	}

	.project-arrow {
		display: inline-block;
		margin-left: 9px;
		color: #7e9189;
		font-size: 15px;
		font-weight: 400;
		transition: color 180ms ease, transform 180ms ease;
	}

	.project-summary {
		margin-top: 5px;
		color: var(--project-muted);
		font-size: 14px;
		line-height: 1.5;
	}

	.project-meta {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		column-gap: 14px;
		row-gap: 5px;
		margin: 10px 0 0 54px;
		color: var(--project-muted);
		font-size: 11px;
		line-height: 1.7;
	}

	.project-status {
		color: var(--project-accent);
	}

	.project-stack {
		overflow-wrap: anywhere;
	}

	.demo-link {
		color: var(--project-accent);
		white-space: nowrap;
	}

	.profile-link:hover,
	.project-link:hover .project-icon,
	.project-link:hover h3,
	.project-link:hover .project-arrow {
		color: var(--project-accent);
	}

	.project-link:hover .project-arrow {
		transform: translate(2px, -2px);
	}

	.demo-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.projects-page a:focus-visible {
		outline: 2px solid var(--project-accent);
		outline-offset: 5px;
		border-radius: 2px;
	}

	@media (max-width: 1100px) {
		.project-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 700px) {
		.projects-page {
			padding: 44px 0 64px;
		}

		.intro > p {
			font-size: 16px;
		}

		.dot-divider {
			margin: 36px 0 26px;
		}

		.project-list {
			grid-template-columns: minmax(0, 1fr);
			gap: 8px;
		}

		.project-entry {
			padding: 18px 0;
		}

		.project-link {
			gap: 12px;
		}

		.project-copy h3 {
			font-size: 17px;
		}

		.project-meta {
			margin-left: 48px;
			column-gap: 10px;
		}

		.demo-link {
			flex-basis: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-entry,
		.project-icon,
		.project-arrow {
			transition: none;
		}
	}
</style>
