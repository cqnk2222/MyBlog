---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { NOTE_SPACES } from '../../data/note-spaces';
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Notes" description="Notes by topic, and questions worth following" /></head>
<body class="home-page">
<Header />
<main class="notes-page">
<header class="page-header"><div class="page-title-row"><h1>Notes</h1><span>A PERSONAL NOTEBOOK</span></div><div class="header-rule"></div></header>
<section class="contents" aria-label="Note spaces">
<div class="contents-label">CONTENTS</div>
<div class="space-list">
{NOTE_SPACES.map((space, index) => <a class="space-row" href={`/notes/${space.slug}/`}><span class="space-index">{String(index + 1).padStart(2, '0')}</span><span class="space-name">{space.slug === 'pretrain' ? 'PreTraining' : space.slug === 'posttrain' ? 'PostTraining' : space.title}</span><span class="space-arrow" aria-hidden="true">→</span></a>)}
</div>
</section>
<footer class="notes-footer"><span>Work in progress · Updated continuously</span></footer>
</main>
<Footer />
</body>
</html>
<style>
.notes-page{max-width:var(--max-width-content);margin:0 auto;padding:40px 40px 90px}.page-header{padding:24px 0 0}.page-title-row{display:flex;align-items:baseline;justify-content:space-between;gap:24px}.page-title-row h1{margin:0;color:var(--text-heading-dark);font-size:32px;font-weight:800}.page-title-row span{color:var(--text-secondary);font-size:15px;letter-spacing:.06em}.header-rule,.notes-footer{border-top:1px solid var(--border-strong)}.header-rule{margin-top:28px}.contents{padding-top:58px}.contents-label{margin-bottom:28px;color:var(--text-secondary);font:600 var(--text-md) var(--font-mono);letter-spacing:.08em}.space-list{border-top:1px solid var(--border-strong)}.space-row{display:grid;grid-template-columns:72px 1fr 30px;align-items:center;min-height:96px;border-bottom:1px solid var(--border-strong);color:inherit;text-decoration:none;transition:padding .18s ease,color .18s ease}.space-row:hover{padding-left:8px;color:var(--notes-primary)}.space-index{color:var(--text-secondary);font:var(--text-md) var(--font-mono)}.space-name{color:var(--text-heading-dark);font-family:var(--font-wenkai);font-size:27px}.space-arrow{color:var(--notes-primary);font-size:25px;text-align:right}.notes-footer{display:flex;justify-content:space-between;margin-top:64px;padding-top:27px;color:var(--text-secondary);font-size:var(--text-md)}@media(max-width:768px){.notes-page{padding:24px 24px 60px}.page-title-row{align-items:flex-start;flex-direction:column;gap:8px}.contents{padding-top:42px}.space-row{grid-template-columns:48px 1fr 24px;min-height:82px}.space-name{font-size:23px}.notes-footer{margin-top:44px}}
</style>
