---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FOLLOWING_CATEGORIES, followingEntryAnchor } from '../../data/following-config.mjs';
import { SITE_TITLE } from '../../consts';
import '../../styles/following.css';

export function getStaticPaths() {
	return FOLLOWING_CATEGORIES.map(category => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const entries = (await getCollection('following', entry => entry.data.category === category.slug))
	.sort((a, b) => b.data.addedDate.valueOf() - a.data.addedDate.valueOf() || a.data.name.localeCompare(b.data.name, 'zh-Hans-CN'));
const sources = await Promise.all(entries.map(async entry => ({ entry, Content: (await render(entry)).Content })));
const tags = [...new Set(entries.flatMap(entry => entry.data.tags))].sort();
const feedCount = entries.filter(entry => entry.data.rss).length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${category.title} · Following - ${SITE_TITLE}`} description={category.description} />
	</head>
	<body class="following-page">
		<Header />
		<main class="following-main category-main" data-category={category.slug}>
			<a class="back-link" href="/following/"><span aria-hidden="true">←</span> Following</a>
			<header class="following-hero">
				<p class="following-eyebrow">Following / {category.label}</p>
				<h1>{category.title}<span class="category-dot" aria-hidden="true">.</span></h1>
				<p class="category-question">{category.question}</p>
				<p class="following-intro">{category.description}</p>
			</header>

			<nav class="category-nav" aria-label="切换关注分类">
				{FOLLOWING_CATEGORIES.map(item => (
					<a href={`/following/${item.slug}/`} data-category={item.slug} aria-current={item.slug === category.slug ? 'page' : undefined}>
						{item.title}
					</a>
				))}
			</nav>

			{entries.length > 0 ? (
				<section class="source-section" aria-labelledby="sources-title">
					<div class="source-heading">
						<h2 id="sources-title">我在关注的来源 <span>{entries.length}</span></h2>
						<p>{feedCount} 个有 RSS · 最近添加在前</p>
					</div>
					{tags.length > 0 && (
						<div class="tag-filters" aria-label="按标签筛选">
							<button type="button" class="tag-filter" data-filter-all aria-pressed="true">全部</button>
							{tags.map(tag => <button type="button" class="tag-filter" data-filter-tag={tag} aria-pressed="false">#{tag}</button>)}
						</div>
					)}
					<p class="result-count" role="status" aria-live="polite" aria-atomic="true">显示 {entries.length} 个来源</p>
					<div class="source-grid">
						{sources.map(({ entry, Content }) => (
							<article class:list={['source-card', { 'has-preview': entry.data.previewImage }]} id={followingEntryAnchor(entry.filePath ?? entry.id)} data-tags={JSON.stringify(entry.data.tags)}>
								{entry.data.previewImage && <a class="source-preview" href={entry.data.url} target="_blank" rel="noopener noreferrer" aria-label={`访问 ${entry.data.name}`}>
									<img src={entry.data.previewImage} alt={`${entry.data.name} 网站截图`} width="1600" height="1000" loading="lazy" decoding="async" />
									<span class="preview-visit" aria-hidden="true">Visit website ↗</span>
								</a>}
								<div class="source-caption">
								{!entry.data.active && <span class="inactive-badge">已停更</span>}
								<h3><a href={entry.data.url} target="_blank" rel="noopener noreferrer">{entry.data.name}<span aria-hidden="true">↗</span></a></h3>
								<p class="source-domain">{new URL(entry.data.url).hostname.replace(/^www\./, '')}</p>
								{entry.data.org && <p class="source-org">{entry.data.org}</p>}
								{entry.body?.trim() && <div class="source-note"><Content /></div>}
								{(entry.data.tags.length > 0 || entry.data.rss) && <footer class="source-footer">
									<ul class="source-tags" aria-label="标签">{entry.data.tags.map(tag => <li>#{tag}</li>)}</ul>
									{entry.data.rss && <a class="rss-link" href={entry.data.rss} target="_blank" rel="noopener noreferrer" aria-label={`订阅 ${entry.data.name} 的 RSS`}>
										<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" fill="currentColor" /></svg>
										RSS
									</a>}
								</footer>}
								</div>
							</article>
						))}
					</div>
					<p class="filter-empty" hidden>这个标签下暂时没有来源，可以试试其他标签。</p>
					</section>
				) : (
				<section class="category-empty" aria-labelledby="empty-title">
					<span class="empty-symbol" aria-hidden="true">＋</span>
					<p class="empty-eyebrow">An open collection</p>
					<h2 id="empty-title">给下一次灵感留个位置</h2>
					<p>这里会慢慢放进值得反复回访的人和作品。<br />遇到喜欢的，再认真记下来。</p>
					<a href="/following/">先看看其他方向 <span aria-hidden="true">→</span></a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<script>
	for (const image of document.querySelectorAll<HTMLImageElement>('.source-preview img')) {
		const fallback = () => {
			image.closest('.source-card')?.classList.remove('has-preview');
			image.closest('a')?.remove();
		};
		image.addEventListener('error', fallback, { once: true });
		if (image.complete && image.naturalWidth === 0) fallback();
	}
	const filters = document.querySelectorAll<HTMLButtonElement>('.tag-filter');
	const cards = [...document.querySelectorAll<HTMLElement>('.source-card')].map(card => ({
		card, tags: JSON.parse(card.dataset.tags || '[]') as string[],
	}));
	const count = document.querySelector('.result-count');
	const empty = document.querySelector<HTMLElement>('.filter-empty');

	for (const filter of filters) {
		filter.addEventListener('click', () => {
			const all = filter.hasAttribute('data-filter-all');
			const tag = filter.dataset.filterTag;
			for (const button of filters) button.setAttribute('aria-pressed', String(button === filter));
			let visible = 0;
			for (const { card, tags } of cards) {
				card.hidden = !all && !tags.includes(tag ?? '');
				if (!card.hidden) visible++;
			}
			if (count) count.textContent = `显示 ${visible} 个来源`;
			if (empty) empty.hidden = visible > 0;
		});
	}
</script>

<style>
	.back-link { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 34px; color: var(--text-secondary); font-size: 13px; }
	.back-link:hover { color: var(--category-accent); }
	.category-main .following-eyebrow { color: var(--category-accent); }
	.category-dot { color: var(--category-accent); }
	.category-question { margin-top: 16px; color: var(--category-accent); font-size: 18px; }
	.category-main .following-intro { margin-top: 10px; font-size: 15px; }
	.category-nav { display: flex; gap: 30px; margin-top: 38px; border-bottom: 1px solid var(--border-strong); }
	.category-nav a { position: relative; padding: 0 0 15px; color: var(--text-secondary); font-size: 13px; }
	.category-nav a:hover, .category-nav a[aria-current="page"] { color: var(--category-accent); }
	.category-nav a[aria-current="page"] { font-weight: 600; }
	.category-nav a[aria-current="page"]::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: var(--category-accent); content: ''; }
	.source-section { margin-top: 32px; }
	.source-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
	.source-heading h2 { color: var(--text-body); font-size: 14px; font-weight: 500; }
	.source-heading h2 > span { margin-left: 8px; color: var(--category-accent); font: 11px var(--font-mono); }
	.source-heading p { color: var(--text-secondary); font-size: 11px; }
	.tag-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
	.tag-filter { padding: 6px 11px; border: 1px solid var(--border-strong); border-radius: 5px; color: var(--text-secondary); font-size: 11px; line-height: 1.6; transition: background .18s ease, border-color .18s ease; }
	.tag-filter:hover, .tag-filter[aria-pressed="true"] { border-color: var(--category-border); background: var(--category-tint); color: var(--category-accent); }
	.result-count { margin-top: 20px; color: var(--text-secondary); font-size: 11px; }
	.source-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 40px 28px; margin-top: 18px; }
	.source-card { min-width: 0; scroll-margin-top: 30px; overflow-wrap: anywhere; }
	.source-card:target { outline: 2px solid var(--category-border); outline-offset: 10px; border-radius: 4px; }
	.source-preview { position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 10; border: 1px solid var(--border-strong); border-radius: 6px; background: var(--bg-white); }
	.source-preview img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
	.preview-visit { position: absolute; right: 12px; bottom: 12px; padding: 7px 10px; border-radius: 4px; background: #182129; color: #fff; font: 10px var(--font-mono); opacity: 0; transition: opacity .2s ease; }
	.source-preview:hover .preview-visit, .source-preview:focus-visible .preview-visit { opacity: 1; }
	.source-caption { padding-top: 16px; }
	.source-card:not(.has-preview) .source-caption { padding-top: 22px; border-top: 1px solid var(--border-strong); }
	.inactive-badge { align-self: flex-start; padding: 2px 7px; border-radius: 3px; background: var(--bg-tag); color: var(--text-secondary); font-size: 10px; }
	.source-card h3 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -.03em; line-height: 1.35; }
	.inactive-badge + h3 { margin-top: 10px; }
	.source-card h3 a { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; color: var(--following-heading); }
	.source-card h3 a:hover { color: var(--category-accent); }
	.source-card h3 a > span { color: var(--category-accent); font-size: 16px; }
	.source-org { margin-top: 7px; color: var(--text-secondary); font: 11px var(--font-mono); }
	.source-domain { margin-top: 6px; color: var(--text-secondary); font: 11px/1.6 var(--font-mono); }
	.source-note { margin-top: 16px; color: var(--text-body); font-size: 14px; line-height: 1.9; }
	.source-note :global(p) { margin: 0 0 10px; }
	.source-note :global(p:last-child) { margin-bottom: 0; }
	.source-note :global(a) { color: var(--category-accent); text-decoration: underline; text-underline-offset: 3px; }
	.source-note :global(code) { padding: 2px 5px; border-radius: 3px; background: var(--bg-code-light); font-size: .9em; }
	.source-note :global(ul), .source-note :global(ol) { padding-left: 20px; }
	.source-footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-top: 14px; }
	.source-tags { display: flex; flex-wrap: wrap; gap: 5px 12px; list-style: none; }
	.source-tags li { color: var(--text-secondary); font: 10px/1.7 var(--font-mono); }
	.rss-link { display: inline-flex; flex-shrink: 0; align-items: center; gap: 5px; padding: 3px 0; color: var(--category-accent); font: 10px var(--font-mono); }
	.rss-link:hover { text-decoration: underline; text-underline-offset: 3px; }
	.filter-empty { padding: 45px 0; color: var(--text-secondary); font-size: 14px; text-align: center; }
	.category-empty { margin-top: 32px; padding: 50px 24px 55px; border: 1px dashed var(--category-border); border-radius: 8px; background: var(--category-tint); text-align: center; }
	.empty-symbol { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border: 1px solid var(--category-border); border-radius: 50%; color: var(--category-accent); font-size: 22px; }
	.empty-eyebrow { margin: 20px 0 12px; color: var(--category-accent); font: 9px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
	.category-empty h2 { color: var(--following-heading); font-size: 23px; font-weight: 500; }
	.category-empty h2 + p { margin-top: 16px; color: var(--text-secondary); font-size: 14px; line-height: 1.9; }
	.category-empty > a { display: inline-flex; gap: 15px; margin-top: 26px; color: var(--category-accent); font-size: 12px; }
	@media (max-width: 640px) {
		.back-link { margin-bottom: 28px; }
		.category-nav { gap: 25px; }
		.category-nav a { font-size: 12px; }
		.source-heading { flex-wrap: wrap; }
		.source-grid { grid-template-columns: minmax(0, 1fr); }
		.source-card h3 { font-size: 21px; }
		.category-empty { padding: 40px 20px; }
		.category-empty h2 { font-size: 21px; }
	}
	@media (prefers-reduced-motion: reduce) { .source-preview img, .preview-visit { transition: none; } .source-preview:hover img, .source-preview:focus-visible img { transform: none; } }
</style>
