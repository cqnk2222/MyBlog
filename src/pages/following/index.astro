---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FOLLOWING_CATEGORIES } from '../../data/following-config.mjs';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Following - ${SITE_TITLE}`} description="Research、Engineering 与 Design。" />

		<!-- 直接输出目录布局，独立于页面样式模块。 -->
		<style is:inline>
			.following-index {
				max-width: var(--max-width-content);
				margin: 0 auto;
				padding: 40px 40px 90px;
			}

			.following-index .page-header { padding: 24px 0 0; }
			.following-index .page-header h1 { margin: 0; color: var(--text-heading-dark); font-size: 32px; font-weight: 800; }
			.following-index .header-rule { margin-top: 28px; border-top: 1px solid var(--border-strong); }
			.following-index .contents { padding-top: 58px; }
			.following-index .contents-label { margin-bottom: 28px; color: var(--text-secondary); font: 600 var(--text-md) var(--font-mono); letter-spacing: .08em; }
			.following-index .category-list { border-top: 1px solid var(--border-strong); }
			.following-index .category-row { display: grid; grid-template-columns: 72px 1fr 30px; align-items: center; min-height: 96px; border-bottom: 1px solid var(--border-strong); color: inherit; text-decoration: none; transition: padding .18s ease, color .18s ease; }
			.following-index .category-row:hover { padding-left: 8px; color: var(--following-primary); }
			.following-index .category-row:focus-visible { outline: 2px solid var(--following-primary); outline-offset: 4px; }
			.following-index .category-index { color: var(--text-secondary); font: var(--text-md) var(--font-mono); }
			.following-index .category-name { color: var(--text-heading-dark); font-family: var(--font-wenkai); font-size: 27px; }
			.following-index .category-arrow { color: var(--following-primary); font-size: 25px; text-align: right; }

			@media (max-width: 768px) {
				.following-index { padding: 24px 24px 60px; }
				.following-index .contents { padding-top: 42px; }
				.following-index .category-row { grid-template-columns: 48px 1fr 24px; min-height: 82px; }
				.following-index .category-name { font-size: 23px; }
			}

			@media (prefers-reduced-motion: reduce) {
				.following-index .category-row { transition: none; }
			}
		</style>
	</head>
	<body class="home-page">
		<Header />
		<main class="following-index">
			<header class="page-header">
				<h1>Following</h1>
				<div class="header-rule"></div>
			</header>
			<section class="contents" aria-label="Following 分类">
				<div class="contents-label">CONTENTS</div>
				<nav class="category-list" aria-label="分类入口">
					{FOLLOWING_CATEGORIES.map((category, index) => (
						<a class="category-row" href={`/following/${category.slug}/`}>
							<span class="category-index">{String(index + 1).padStart(2, '0')}</span>
							<span class="category-name">{category.title}</span>
							<span class="category-arrow" aria-hidden="true">→</span>
						</a>
					))}
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>
