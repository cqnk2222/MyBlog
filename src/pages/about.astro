---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`About - ${SITE_TITLE}`}
			description="A long-term workspace for learning in public. 墨干了，字便不再属于我。"
		/>
	</head>
	<body>
		<Header />

		<main class="about-page">
			<h1 class="eyebrow">About</h1>

			<section class="block" lang="en">
				<p class="statement">
					A long-term workspace for learning in public. I keep it because understanding fades faster
					than I'd like, and writing is the slowest, most reliable way I know to hold on to it.
				</p>
			</section>

			<section class="block">
				<p class="line line-dry">墨干了，字便不再属于我。</p>
				<p class="line line-wet">这里存着的，是还没干透的东西。</p>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-page {
		max-width: var(--max-width-essay);
		margin: 0 auto;
		padding: 4.5rem 2rem 6rem;
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-meta);
	}

	.block {
		padding: 44px 0;
	}

	/* 分隔线向右淡出，呼应「墨会干」 */
	.block + .block {
		border-top: 1px solid transparent;
		border-image: linear-gradient(90deg, var(--border-strong), transparent) 1;
	}

	/* 英文 */
	.statement {
		margin: 0;
		max-width: 46ch;
		font-family: var(--font-inter);
		font-size: var(--text-3xl);
		font-weight: 300;
		line-height: var(--leading-body);
		letter-spacing: -0.005em;
		color: var(--text-body);
	}

	/* 中文 */
	.line {
		margin: 0;
		font-family: var(--font-wenkai);
		font-size: var(--text-5xl);
		line-height: var(--leading-body-xl);
		letter-spacing: 0.02em;
	}

	/* 干了的那句淡下去，没干透的那句才是浓墨 */
	.line-dry {
		color: var(--essays-body);
		opacity: 0.5;
	}

	.line-wet {
		color: var(--essays-body);
	}

	@media (max-width: 768px) {
		.about-page {
			padding: 2rem 1.5rem 3.5rem;
		}

		.block {
			padding: 28px 0;
		}

		.statement {
			max-width: none;
			font-size: var(--text-2xl);
		}

		.line {
			font-size: var(--text-3xl);
		}
	}
</style>
