				color: transparent;
			}

			.ed-field-input .ed-datepicker::-webkit-calendar-picker-indicator {
				opacity: 0.5;
			}

			.ed-field-input input[type='checkbox'] {
				flex: 0 0 auto;
				width: 16px;
				height: 16px;
				min-width: 0;
				margin: 2px 0;
				accent-color: var(--notes-primary);
			}

			.ed-field-input select {
				flex: 1;
				min-width: 0;
				padding: 7px 9px;
				border: 1px solid var(--border-button-alt);
				border-radius: var(--radius-sm);
				background: var(--bg-white);
				font-size: var(--text-md);
			}

			.ed-meta-foot {
				display: flex;
				gap: 8px;
				padding: 0 20px 16px;
			}

			.ed-toolbar {
				display: flex;
				align-items: center;
				gap: 4px;
				flex-wrap: wrap;
				padding: 8px 16px;
				border-bottom: 1px solid var(--border-weak);
				background: #fcfdfe;
				flex-shrink: 0;
			}

			.ed-toolbar button {
				padding: 4px 9px;
				border: 1px solid transparent;
				border-radius: var(--radius-sm);
				background: transparent;
				color: var(--text-tertiary);
				font-size: var(--text-sm-plus);
			}

			.ed-toolbar button:hover {
				border-color: var(--border-button-alt);
				background: var(--bg-white);
				color: var(--notes-primary-dark);
			}

			.ed-toolbar-gap {
				flex: 1;
			}

			.ed-count {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				color: var(--text-meta-light);
			}

			#body {
				flex: 1;
				min-height: 0;
				width: 100%;
				padding: 24px 28px 40px;
				border: none;
				resize: none;
				font-family: var(--font-mono), ui-monospace, Menlo, monospace;
				font-size: var(--text-md-plus);
				line-height: 1.85;
				color: var(--text-body);
				tab-size: 2;
			}

			/* ----------------------------------------------------------- preview */

			.ed-preview {
				display: flex;
				flex-direction: column;
				min-width: 0;
				min-height: 0;
				background: var(--bg-white);
			}

			.ed-preview-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-right: 16px;
				border-bottom: 1px solid var(--border-weak);
				flex-shrink: 0;
			}

			.ed-preview-head .ed-tabs {
				border-bottom: none;
			}

			.ed-open {
				font-size: var(--text-sm);
				color: var(--text-tertiary);
				text-decoration: none;
			}

			.ed-open:hover {
				color: var(--notes-primary);
			}

			.ed-preview-body {
				flex: 1;
				min-height: 0;
				overflow: hidden;
				display: flex;
			}

			#preview-frame {
				flex: 1;
				border: none;
				background: #fff;
			}

			#preview-draft {
				flex: 1;
				overflow-y: auto;
				padding: 32px 34px 60px;
			}

			.ed-frame-hint {
				position: absolute;
				top: 50%;
				left: 0;
				right: 0;
				margin: 0;
				text-align: center;
				color: var(--text-meta-light);
				font-size: var(--text-md);
			}

			.ed-preview-body {
				position: relative;
			}

			/* 与 NotesLayout 的正文样式保持一致，改一边记得改另一边 */
			.prose {
				font-size: var(--text-prose);
				line-height: var(--leading-looser);
				color: var(--text-body);
			}

			.prose h2 {
				margin: 40px 0 14px;
				font-weight: 700;
				font-size: var(--text-4xl);
				letter-spacing: -0.01em;
				color: var(--text-heading);
			}

			.prose h2:first-child {
				margin-top: 0;
			}

			.prose h3 {
				margin: 28px 0 10px;
				font-weight: 600;
				font-size: var(--text-2xl);
				color: var(--text-heading);
			}

			.prose p {
				margin: 0 0 18px;
			}

			.prose ul,
			.prose ol {
				margin: 0 0 20px;
				padding-left: 22px;
				line-height: 1.72;
			}

			.prose li {
				margin-bottom: 6px;
			}

			.prose blockquote {
				margin: 0 0 24px;
				padding-left: 16px;
				border-left: 3px solid var(--notes-border);
				color: var(--text-secondary);
			}

			.prose pre {
				margin: 0 0 26px;
				padding: 16px 18px;
				border-radius: var(--radius-md);
				overflow-x: auto;
				font-size: var(--text-base-plus);
				line-height: 1.7;
			}

			.prose :not(pre) > code {
				padding: 2px 6px;
				border-radius: 4px;
				background: var(--bg-code-light);
				font-size: 0.88em;
			}

			.prose img {
				max-width: 100%;
			}

			.prose .callout {
				display: flex;
				gap: 14px;
				padding: 16px 20px;
				background: var(--notes-bg-lighter);
				border: 1px solid var(--notes-border);
				border-left: 3px solid var(--notes-primary);
				border-radius: var(--radius-md);
				margin-bottom: 28px;
			}

			.prose .callout p {
				margin: 0;
				font-size: var(--text-lg);
				line-height: var(--leading-looser);
				color: #2c4a60;
			}

			.ed-render-error {
				color: #c4553d;
				font-size: var(--text-md);
			}

			/* ----------------------------------------------------------- dialogs */

			dialog {
				border: none;
				border-radius: var(--radius-2xl);
				padding: 0;
				box-shadow: 0 18px 60px rgba(16, 25, 31, 0.22);
				max-width: min(560px, 92vw);
			}

			dialog::backdrop {
				background: rgba(16, 25, 31, 0.32);
			}

			.ed-dialog {
				display: flex;
				flex-direction: column;
				gap: 12px;
				padding: 24px 26px 20px;
			}

			.ed-dialog h3 {
				margin: 0;
				font-size: var(--text-5xl);
				color: var(--text-heading);
			}

			.ed-dialog label {
				display: flex;
				flex-direction: column;
				gap: 5px;
				font-size: var(--text-md);
				color: var(--text-tertiary);
			}

			.ed-dialog label > span {
				font-size: var(--text-sm);
				color: var(--text-meta);
			}

			.ed-dialog input:not([type='checkbox']),
			.ed-dialog select {
				padding: 8px 11px;
				border: 1px solid var(--border-button-alt);
				border-radius: var(--radius-sm);
				font-size: var(--text-md);
			}

			.ed-dialog small {
				font-family: var(--font-mono);
				font-size: var(--text-xs);
				color: var(--text-meta-light);
			}

			.ed-dialog menu {
				display: flex;
				justify-content: flex-end;
				gap: 8px;
				margin: 6px 0 0;
				padding: 0;
			}

			.ed-dialog-note {
				margin: 0;
				font-size: var(--text-md);
				line-height: var(--leading-loose);
				color: var(--text-secondary);
			}

			.ed-dialog-note em {
				color: #c2703e;
				font-style: normal;
			}

			.ed-dialog-error {
				margin: 0;
				color: #c4553d;
				font-size: var(--text-md);
			}

			.ed-changes {
				max-height: 160px;
				overflow-y: auto;
				padding: 10px 12px;
				border: 1px solid var(--border-weak);
				border-radius: var(--radius-md);
				background: var(--bg-sidebar);
				font-family: var(--font-mono);
				font-size: var(--text-sm);
				color: var(--text-secondary);
				line-height: 1.9;
			}

			.ed-log {
				max-height: 220px;
				overflow: auto;
				margin: 0;
				padding: 12px 14px;
				border-radius: var(--radius-md);
				background: var(--code-bg);
				color: var(--code-text);
				font-size: var(--text-sm);
				line-height: 1.65;
				white-space: pre-wrap;
			}

			/* ------------------------------------------------------------- toast */

			.ed-toast {
				position: fixed;
				left: 50%;
				bottom: 28px;
				transform: translateX(-50%);
				padding: 10px 18px;
				border-radius: var(--radius-pill);
				background: var(--text-heading-dark);
				color: #fff;
				font-size: var(--text-md);
				box-shadow: 0 8px 24px rgba(16, 25, 31, 0.28);
				z-index: 20;
			}

			.ed-toast[data-kind='error'] {
				background: #a8402c;
			}

			@media (max-width: 1200px) {
				.ed-body {
					grid-template-columns: 220px 1fr;
				}

				.ed-preview {
					display: none;
				}
			}
		</style>
	</body>
</html>
