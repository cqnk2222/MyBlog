---
// 新版 Footer - 按设计稿像素级还原
const today = new Date();
---

<footer>
	<div class="footer-content">
		<span>© {today.getFullYear()} Krinein Hao</span>
		<span class="footer-meta">Powered by Astro · by kk</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border-strong);
		padding: 30px 40px;
	}

	.footer-content {
		max-width: var(--max-width-content);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		font-size: var(--text-md);
		color: var(--about-subtitle);
	}

	.footer-meta {
		font-family: var(--font-mono);
		font-size: var(--text-base);
	}

	@media (max-width: 768px) {
		footer {
			padding: 24px;
		}

		.footer-content {
			flex-direction: column;
			text-align: center;
			gap: 8px;
		}
	}
</style>
