---
import type { NoteSpaceSeries } from '../data/note-spaces';

interface Props {
	series: NoteSpaceSeries[];
	emptyMessage?: string;
}

const { series, emptyMessage = '这个分区暂时还没有笔记。' } = Astro.props;
---

{series.length > 0 ? (
	<div class="series-list" aria-label="系列目录">
		{series.map((group, index) => (
			<a class="series-row" href={group.href}>
				<span class="series-index">{String(index + 1).padStart(2, '0')}</span>
				<span class="series-name">{group.series}</span>
				<span class="series-count">{group.count} 篇笔记</span>
				<span class="series-arrow" aria-hidden="true">→</span>
			</a>
		))}
	</div>
) : (
	<div class="empty-state">{emptyMessage}</div>
)}

<style>
	.series-list { border-top: 1px solid var(--border-strong); }
	.series-row {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr) 110px 30px;
		align-items: center;
		gap: 12px;
		min-height: 96px;
		padding: 16px 0;
		border-bottom: 1px solid var(--border-strong);
		color: inherit;
		text-decoration: none;
		transition: padding .18s ease, color .18s ease;
	}
	.series-row:hover { padding-left: 8px; color: var(--notes-primary); }
	.series-row:focus-visible { outline: 2px solid var(--notes-primary); outline-offset: 4px; }
	.series-index { color: var(--text-secondary); font: var(--text-md) var(--font-mono); }
	.series-name { color: var(--text-heading-dark); font-family: var(--font-wenkai); font-size: 27px; line-height: 1.4; overflow-wrap: anywhere; }
	.series-count { color: var(--text-secondary); font: var(--text-sm) var(--font-mono); text-align: right; }
	.series-arrow { color: var(--notes-primary); font-size: 25px; text-align: right; }
	.empty-state { border-block: 1px solid var(--border-strong); padding: 42px 0; color: var(--text-secondary); font-size: var(--text-lg); }
	@media (max-width: 768px) {
		.series-row { grid-template-columns: 48px minmax(0, 1fr) 24px; grid-template-rows: auto auto; gap: 4px 0; min-height: 96px; }
		.series-index { grid-column: 1; grid-row: 1 / 3; }
		.series-name { grid-column: 2; grid-row: 1; font-size: 23px; }
		.series-count { grid-column: 2; grid-row: 2; text-align: left; }
		.series-arrow { grid-column: 3; grid-row: 1 / 3; }
	}
</style>
