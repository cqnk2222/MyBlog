<canvas class="project-backdrop" data-project-backdrop aria-hidden="true"></canvas>

<script>
	import { createProjectBackdrop } from './project-backdrop.mjs';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-project-backdrop]');
	if (canvas) {
		let stop = () => {};
		const mount = () => {
			stop();
			stop = createProjectBackdrop(canvas);
		};
		mount();
		window.addEventListener('pageshow', mount);
		window.addEventListener('pagehide', () => stop());
	}
</script>

<style>
	.project-backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
		background-image: radial-gradient(circle, #cccccc70 1px, transparent 1px);
		background-size: 15px 15px;
	}

	.project-backdrop[data-ready='true'] {
		background-image: none;
	}
</style>
